# ===== LLM (OpenAI-compatible) =====
# Mặc định: Gemini trực tiếp (https://aistudio.google.com/apikey)
# Qua 9router (chống rate-limit): LLM_BASE_URL=http://host.docker.internal:20128/v1
#   — host.docker.internal trỏ về máy host nhờ extra_hosts trong docker-compose.yml
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# auto: no key -> explicit demo; live never silently falls back
LLM_MODE=auto
LLM_MAX_TOKENS=16000
MAX_REVISION_ROUNDS=2

# ===== Databases (map với docker-compose) =====
DATABASE_URL=postgresql+asyncpg://truyenai:truyenai@localhost:54329/truyenai
REDIS_URL=redis://localhost:63790/0

# ===== Server =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:13000
