# ===== LLM (OpenAI-compatible) =====
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# Điền key Gemini của bạn vào đây (https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# auto: no key -> explicit demo; live never silently falls back
LLM_MODE=auto
LLM_MAX_TOKENS=16000
MAX_REVISION_ROUNDS=2

# ===== Databases (map với docker-compose) =====
DATABASE_URL=postgresql+asyncpg://truyenai:truyenai@localhost:54329/truyenai
REDIS_URL=redis://localhost:63790/0

# ===== Server =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:13000
