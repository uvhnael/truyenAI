# ===== LLM (OpenAI-compatible) =====
# Mặc định: Gemini trực tiếp (https://aistudio.google.com/apikey)
# Qua 9router (chống rate-limit): LLM_BASE_URL=http://host.docker.internal:20128/v1
#   — host.docker.internal trỏ về máy host nhờ extra_hosts trong docker-compose.yml
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# auto: no key -> explicit demo; live never silently falls back
LLM_MODE=auto
LLM_MAX_TOKENS=16000

# Kokoro-Vietnamese TTS (torch, CPU/GPU cục bộ — không dùng 9router)
# TTS_MODEL_DIR để trống: model + voicepack tải từ HuggingFace cache khi chạy lần đầu.
TTS_MODEL_DIR=
TTS_VOICE=diem_trinh
TTS_DEVICE=cpu
AUDIO_DIR=data/audio
MAX_REVISION_ROUNDS=2

# ===== Databases (map với docker-compose) =====
DATABASE_URL=postgresql+asyncpg://truyenai:truyenai@localhost:54329/truyenai
REDIS_URL=redis://localhost:63790/0

# ===== Server =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:13000

# ===== Social publishing (OAuth apps) =====
# TikTok Content Posting API — create app at https://developers.tiktok.com
# cần scopes: video.publish, user.info.basic. Live publish cần app audit/approval.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube Data API v3 — OAuth 2.0 client ở Google Cloud Console.
# cần scopes: youtube.upload, youtube.readonly, userinfo.email
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Public base mà callback OAuth redirect về (thường là WEB_ORIGIN của dashboard)
SOCIAL_REDIRECT_BASE=http://localhost:18080
